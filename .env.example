# One OpenRouter key covers both roles: the responder LLM and Jev decisions.
OPENROUTER_API_KEY=sk-or-v1-...

# --- Responder LLM (open answer space) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RESPONDER_MODEL=google/gemini-2.5-flash-lite

# --- Jev (bounded decisions) ---
JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13
# Restrict routing to zero-data-retention providers. Leave it on.
JEV_ZDR=true
JEV_MAX_RPS=15
