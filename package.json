{
  "name": "guarded-agent",
  "version": "0.1.0",
  "description": "Runtime for conversational AI agents that run inside a real operation: deterministic gates, calibrated bounded decisions, vetoable actions and human takeover.",
  "keywords": [
    "agent",
    "llm",
    "jev",
    "typesafe",
    "whatsapp",
    "guardrails",
    "policy"
  ],
  "homepage": "https://github.com/marianoberton/guarded-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianoberton/guarded-agent.git"
  },
  "bugs": {
    "url": "https://github.com/marianoberton/guarded-agent/issues"
  },
  "author": "Mariano Berton",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src examples tests",
    "format": "prettier --write .",
    "example": "tsx examples/dealership/index.ts",
    "compare": "tsx examples/dealership/compare.ts",
    "ping": "tsx examples/jev-ping.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "test:db": "vitest run --config vitest.live.config.ts tests/stores",
    "example:express": "tsx examples/express/index.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "pg": "^8.13.1",
    "@types/pg": "^8.11.10"
  },
  "peerDependencies": {
    "pg": "^8.13.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
